% ---------------------------------------------------------------------
% Joint-coordinate conventions and shoulder rhythm (Section B / C)
% ---------------------------------------------------------------------
@article{wu2005,
  author  = {Wu, Ge and van der Helm, Frans C. T. and Veeger, H. E. J.
             and Makhsous, Mohsen and Van Roy, Peter and Anglin, Carolyn
             and Nagels, Jochem and Karduna, Andrew R. and McQuade, Kevin
             and Wang, Xuguang and Werner, Frederick W. and
             Buchholz, Bryan},
  title   = {{ISB} Recommendation on Definitions of Joint Coordinate
             Systems of Various Joints for the Reporting of Human Joint
             Motion---{Part II}: Shoulder, Elbow, Wrist and Hand},
  journal = {Journal of Biomechanics},
  year    = {2005},
  volume  = {38},
  number  = {5},
  pages   = {981--992},
  doi     = {10.1016/j.jbiomech.2004.05.042},
  pmid    = {15844264},
  note    = {ISB upper-limb standard. Thorax frame (origin at IJ) is the
             proximal reference; recommended sequences: humerothoracic
             Y-X-Y (plane of elevation, elevation, axial rotation),
             scapula and clavicle Y-X-Z relative to thorax. The Y-X-Y
             proper-Euler sequence is singular when the middle (elevation)
             angle is 0 deg (arm at side) or 180 deg (overhead), NOT at
             ~90 deg. Central reference for the Kinatrax->OpenSim
             convention-mapping SOP.}
}

@article{groodsuntay1983,
  author  = {Grood, Edward S. and Suntay, Wilfredo J.},
  title   = {A Joint Coordinate System for the Clinical Description of
             Three-Dimensional Motions: Application to the Knee},
  journal = {Journal of Biomechanical Engineering},
  year    = {1983},
  volume  = {105},
  number  = {2},
  pages   = {136--144},
  doi     = {10.1115/1.3138397},
  note    = {Joint Coordinate System (JCS): two body-fixed axes plus a
             mutually perpendicular floating axis. The JCS is generally
             NON-orthogonal, so reported angles are sequence/convention
             dependent and mathematically equivalent to a specific
             Cardan/Euler sequence. Adopted by the ISB as the general
             joint-motion reporting framework.}
}

@article{degroot2001,
  author  = {de Groot, Jurriaan H. and Brand, Ron},
  title   = {A Three-Dimensional Regression Model of the Shoulder Rhythm},
  journal = {Clinical Biomechanics},
  year    = {2001},
  volume  = {16},
  number  = {9},
  pages   = {735--743},
  doi     = {10.1016/S0268-0033(01)00065-1},
  pmid    = {11714550},
  note    = {Thorax-fixed regression predicting clavicular and scapular
             Euler angles from humeral orientation (plus external force
             direction and initial orientation): five linear equations,
             10 subjects, 23 humeral positions; gender/morphology not
             significant. Basis of scapula-generation method (2). The
             classic overall glenohumeral:scapulothoracic ratio is ~2:1
             but nonlinear over the elevation range.}
}

