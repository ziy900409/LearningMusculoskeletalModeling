@article{phadke2011,
  author  = {Phadke, Vandana and Braman, Jonathan P. and
             LaPrade, Robert F. and Ludewig, Paula M.},
  title   = {Comparison of Glenohumeral Motion Using Different
             Rotation Sequences},
  journal = {Journal of Biomechanics},
  year    = {2011},
  volume  = {44},
  number  = {4},
  pages   = {700--705},
  doi     = {10.1016/j.jbiomech.2010.10.042},
  pmid    = {21093867},
